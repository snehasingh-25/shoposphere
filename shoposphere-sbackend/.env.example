# Server
PORT=3004
HOST=0.0.0.0
NODE_ENV=production

# Database (Hostinger MySQL)
DATABASE_URL=

# After moving from shoposphere.in → descko.in
FRONTEND_URL=https://descko.in
# Comma-separated extra origins (optional; defaults include descko + shoposphere during transition)
# CORS_ORIGINS=https://descko.in,https://www.descko.in

# Session cookie name on api.descko.in (use descko_auth after rebrand)
AUTH_COOKIE_NAME=descko_auth

# Google OAuth — add redirect URIs in Google Cloud Console for api.descko.in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.descko.in/auth/login/federated/google/callback

# Razorpay, Cloudinary, etc. (unchanged from current production)